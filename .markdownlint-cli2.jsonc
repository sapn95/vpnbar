{
  "config": {
    // Prose here is hard-wrapped for the diff, not for a column counter.
    "MD013": false,
    // The documents start at h1 and use one level of headings under it.
    "MD024": { "siblings_only": true },
    // The pull request template opens with an HTML comment and then an h2, on
    // purpose: it is pasted into a body that already has a title above it.
    "MD041": false
  },
  "globs": ["**/*.md"]
}
