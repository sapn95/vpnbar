#!/usr/bin/env bash
# The command line half of vpnbar: link the Spoon into Hammerspoon, take it out
# again, and say what is wrong when the icon is not where it should be.
#
# Homebrew installs the Spoon into its own prefix and must not write to a home
# directory, so linking is a separate step the user asks for. `doctor` exists
# because the first thing that goes wrong is not vpnbar at all — it is a menu
# bar manager holding the icon off-screen, which looks exactly like a program
# that failed to start.
set -euo pipefail

readonly SPOONS="${HOME}/.hammerspoon/Spoons"
# Overridable for the tests, which have no Hammerspoon to find.
readonly HAMMERSPOON_APP="${VPNBAR_HAMMERSPOON_APP:-/Applications/Hammerspoon.app}"
readonly INIT="${HOME}/.hammerspoon/init.lua"
readonly APP_DIR="${VPNBAR_APP_DIR:-${HOME}/Applications}"
readonly LOAD_LINE='hs.loadSpoon("VpnBar"):start()'
# What counts as "init.lua loads it". Matching the whole suggested line would
# call a config that keeps a handle on the Spoon — the two-line form — broken.
readonly LOAD_MARK='loadSpoon("VpnBar")'
# What a menu bar manager calls this icon: the application's bundle id plus the
# autosave name the Spoon gives its status item. Without that name it would be
# an ordinal, and an ordinal is not something a decision can stick to — see
# docs/adr/0016-the-menu-bar-item-has-a-name.md.
readonly BARTENDER_ID="org.hammerspoon.Hammerspoon-vpnbar"

# `timeout` is GNU and not on a stock macOS. A Hammerspoon that is wedged, or
# whose ipc is off, must not hang the doctor.
run_with_timeout() {
  local seconds="$1"
  shift
  "$@" &
  local worker=$!
  (
    sleep "${seconds}"
    kill -TERM "${worker}" 2>/dev/null
  ) &
  local watcher=$!
  wait "${worker}" 2>/dev/null
  local code=$?
  kill -TERM "${watcher}" 2>/dev/null
  wait "${watcher}" 2>/dev/null || true
  return "${code}"
}

# Homebrew puts a symlink in its bin and the real file in the Cellar, so the
# path this script was invoked by says nothing about where its Spoon is.
# Bounded, because a symlink cycle is an unbounded loop and this is a command
# somebody types. The Lua side already refuses to walk a cycle for the same
# reason — `findPressable` is depth-limited so an accessibility tree cannot hang
# Hammerspoon — and the shell half had no such limit. 32 is what the kernel
# allows before it gives up with ELOOP.
resolve_symlinks() {
  local target="$1" link hops=0
  while [ -L "${target}" ]; do
    hops=$((hops + 1))
    if [ "${hops}" -gt 32 ]; then
      echo "too many symlinks to follow from $1" >&2
      return 1
    fi
    link="$(readlink "${target}")"
    case "${link}" in
      /*) target="${link}" ;;
      *) target="$(dirname "${target}")/${link}" ;;
    esac
  done
  printf '%s\n' "${target}"
}

# Where the Spoon we install from lives.
#
# Homebrew first, by way of `brew --prefix vpnbar`, which answers with the
# stable `opt` path rather than the Cellar path carrying the version in it.
# Linking to the Cellar would leave a dangling symlink after the next upgrade,
# and a dangling Spoon is a menu bar with nothing in it and no error anywhere.
spoon_source() {
  local opt here
  opt="$(brew --prefix vpnbar 2>/dev/null || true)"
  if [ -n "${opt}" ] && [ -d "${opt}/libexec/VpnBar.spoon" ]; then
    printf '%s\n' "${opt}/libexec/VpnBar.spoon"
    return
  fi
  here="$(cd "$(dirname "$(resolve_symlinks "${BASH_SOURCE[0]}")")/.." && pwd)"
  if [ -d "${here}/VpnBar.spoon" ]; then
    printf '%s\n' "${here}/VpnBar.spoon"
  else
    printf '%s\n' "${here}/libexec/VpnBar.spoon"
  fi
}

# A link that points at nothing is one failure; a real directory sitting where
# the link belongs is the other, and it is the quieter one. A copy keeps working
# and stops tracking, so `brew upgrade` updates something nobody is running.
# Both are told apart here rather than by "is there a directory".
spoon_link_is_live() {
  [ -L "${SPOONS}/VpnBar.spoon" ] && [ -d "${SPOONS}/VpnBar.spoon/" ]
}

spoon_is_stale_copy() {
  [ ! -L "${SPOONS}/VpnBar.spoon" ] && [ -d "${SPOONS}/VpnBar.spoon" ]
}

ok() { printf '  ok    %s\n' "$1"; }
bad() { printf '  FAIL  %s\n' "$1"; }
note() { printf '        %s\n' "$1"; }

cmd_link() {
  local source
  source="$(spoon_source)"
  [ -d "${source}" ] || {
    echo "no VpnBar.spoon at ${source}" >&2
    exit 1
  }
  mkdir -p "${SPOONS}"
  # `ln -sfn` onto a real directory puts the link *inside* it, which is how a
  # copy survives being "relinked" and goes on being the code that runs. Take it
  # out first, and say so, because deleting a directory should never be silent.
  if spoon_is_stale_copy; then
    echo "replacing the copy at ${SPOONS}/VpnBar.spoon with a link"
    rm -rf "${SPOONS}/VpnBar.spoon"
  fi
  ln -sfn "${source}" "${SPOONS}/VpnBar.spoon"
  echo "linked ${SPOONS}/VpnBar.spoon -> ${source}"
  if [ -f "${INIT}" ] && grep -qF "${LOAD_MARK}" "${INIT}"; then
    echo "${INIT} already loads it"
  else
    echo
    echo "Add this to ${INIT} and reload Hammerspoon:"
    echo
    echo "    ${LOAD_LINE}"
  fi
  echo
  echo "For an icon in Launchpad and Spotlight: ${0##*/} app"
}

# Something to click. vpnbar is a Hammerspoon Spoon, so there has never been an
# icon in Launchpad or a name Spotlight could find, and when the menu bar item
# is gone there is nothing on the whole machine that looks like a way back in.
# This is the smallest bundle macOS will treat as an application: a launcher
# that runs `vpnbar start` and gets out of the way.
#
# LSUIElement, because it starts something else and exits. Without it the Dock
# shows a bouncing icon for a program that is already finished.
cmd_app() {
  local me app invoked
  invoked="${BASH_SOURCE[0]}"
  # Absolute, always: the Finder launches a bundle from a working directory that
  # has nothing to do with where this was invoked from, so a relative path here
  # produces an app that works when tested from the checkout and nowhere else.
  #
  # Absolute, but *not* resolved through its last symlink. /opt/homebrew/bin/vpnbar
  # points into the Cellar at a path carrying the version, and following it would
  # bake that version into the launcher; the next `brew upgrade` removes that keg
  # and leaves an app pointing at nothing. The same trap as linking the Spoon to
  # the Cellar instead of to opt.
  case "${invoked}" in
    /*) me="${invoked}" ;;
    */*) me="$(cd "$(dirname "${invoked}")" && pwd)/$(basename "${invoked}")" ;;
    *) me="$(command -v "${invoked}")" ;;
  esac
  app="${APP_DIR}/vpnbar.app"
  mkdir -p "${app}/Contents/MacOS"
  cat >"${app}/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>vpnbar</string>
  <key>CFBundleDisplayName</key><string>vpnbar</string>
  <key>CFBundleIdentifier</key><string>ch.sapn.vpnbar.launcher</string>
  <key>CFBundleExecutable</key><string>vpnbar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
  cat >"${app}/Contents/MacOS/vpnbar" <<LAUNCHER
#!/usr/bin/env bash
# Written by \`vpnbar app\`. Starts the Spoon inside Hammerspoon and exits.
exec "${me}" start
LAUNCHER
  chmod +x "${app}/Contents/MacOS/vpnbar"
  # Without this the Finder can go on showing a bundle it has already cached.
  touch "${app}"
  echo "installed ${app}"
  echo "It runs: ${me} start"
}

cmd_unlink() {
  # -f alone cannot remove a directory, so a stale copy survived `unlink` and
  # went on being loaded by Hammerspoon.
  rm -rf "${SPOONS}/VpnBar.spoon"
  echo "removed ${SPOONS}/VpnBar.spoon"
  if [ -d "${APP_DIR}/vpnbar.app" ]; then
    rm -rf "${APP_DIR}/vpnbar.app"
    echo "removed ${APP_DIR}/vpnbar.app"
  fi
  echo "The line in ${INIT} is left alone; take it out by hand."
}

# `hs` lives inside the Hammerspoon bundle and is only on PATH because something
# put a symlink there. An app launched from the Finder gets
# /usr/bin:/bin:/usr/sbin:/sbin and nothing else, so looking it up on PATH alone
# is a launcher that works from a terminal and silently does nothing when
# double-clicked. The bundle is the location that does not depend on a shell
# profile, so it is asked first.
find_hs() {
  local candidate
  # An explicit answer wins over any search. The tests set it, because a search
  # that reaches an absolute path finds the real Hammerspoon on a developer's
  # machine and a "test" then starts the menu somebody is actually using.
  if [ -n "${VPNBAR_HS:-}" ]; then
    [ -x "${VPNBAR_HS}" ] || return 1
    printf '%s\n' "${VPNBAR_HS}"
    return 0
  fi
  for candidate in \
    "${HAMMERSPOON_APP}/Contents/Frameworks/hs/hs" \
    /opt/homebrew/bin/hs \
    /usr/local/bin/hs; do
    [ -x "${candidate}" ] && {
      printf '%s\n' "${candidate}"
      return 0
    }
  done
  command -v hs 2>/dev/null && return 0
  return 1
}

# Asking Hammerspoon to do something, with the same timeout the doctor uses: a
# wedged Hammerspoon must not hang a command somebody typed to fix it.
#
# The answer comes back in a variable rather than down a pipe. Through a pipe
# the reporting half runs in a subshell, so its `exit 1` ends the subshell and
# the script carries on as if the command had worked.
ask_hammerspoon() {
  local hs_bin answer
  hs_bin="$(find_hs)" || {
    echo "Hammerspoon's command line is missing. Run this in the" >&2
    echo "Hammerspoon console:" >&2
    echo >&2
    echo "    hs.ipc.cliInstall()" >&2
    return 1
  }
  answer="$(run_with_timeout 10 "${hs_bin}" -c "$1" 2>/dev/null | tail -1)"
  case "${answer}" in
    FAIL*)
      echo "${answer#FAIL }" >&2
      return 1
      ;;
    "")
      echo "no answer from Hammerspoon" >&2
      return 1
      ;;
    *)
      printf '%s\n' "${answer}"
      ;;
  esac
}

# Does Hammerspoon's command line answer *right now*? The process existing is
# not the same question: after `open`, Hammerspoon is in the process table well
# before ipc is listening, so waiting on pgrep alone returns a moment too early
# and the first real request comes back empty — "no answer from Hammerspoon" on
# an ordinary cold start.
hammerspoon_answers() {
  local hs_bin
  hs_bin="$(find_hs)" || return 1
  [ -n "$(run_with_timeout 3 "${hs_bin}" -c 'return "up"' 2>/dev/null | tail -1)" ]
}

# Hammerspoon has to be up *and answering* before it can be asked anything.
ensure_hammerspoon() {
  hammerspoon_answers && return 0
  if ! pgrep -f 'Hammerspoon.app/Contents/MacOS' >/dev/null 2>&1; then
    [ -d "${HAMMERSPOON_APP}" ] || {
      echo "Hammerspoon is not installed — brew install --cask hammerspoon" >&2
      return 1
    }
    echo "starting Hammerspoon"
    open -a "${HAMMERSPOON_APP}"
  fi
  local waited=0
  while [ "${waited}" -lt 20 ]; do
    hammerspoon_answers && return 0
    sleep 1
    waited=$((waited + 1))
  done
  echo "Hammerspoon did not come up within 20 seconds" >&2
  echo "If it is running, its command line may be off — in the console:" >&2
  echo >&2
  echo "    hs.ipc.cliInstall()" >&2
  return 1
}

# `Quit vpnbar` stops the Spoon and leaves Hammerspoon running, which is the
# whole point of it — Hammerspoon is doing other jobs on this machine. Until
# these verbs existed the only way back was reloading Hammerspoon and every
# other config with it, so the menu had a way out and no way in.
cmd_start() {
  ensure_hammerspoon || exit 1
  # The cached modules are dropped before the Spoon is loaded. hs.loadSpoon
  # returns whatever is already in spoon.VpnBar, and require returns whatever
  # is already in package.loaded, so a start after brew upgrade ran the code
  # from before the upgrade — every time, on every upgrade so far — and only a
  # full hs.reload, with every other config in it, brought the installed code
  # in. Nothing loaded is lost: a running Spoon returns before this, and a
  # stopped one holds nothing worth keeping.
  ask_hammerspoon '
    if _G.vpnbar and _G.vpnbar.running then return "already running" end
    for name in pairs(package.loaded) do
      if name == "vpnbar" or name:sub(1, 7) == "vpnbar." then package.loaded[name] = nil end
    end
    spoon.VpnBar = nil
    local ok, loaded = pcall(hs.loadSpoon, "VpnBar")
    if not ok or not loaded then return "FAIL could not load the Spoon: " .. tostring(loaded) end
    _G.vpnbar = loaded:start()
    return _G.vpnbar.running and "started" or "FAIL start did not take"
  '
}

cmd_stop() {
  ask_hammerspoon '
    if not (_G.vpnbar and _G.vpnbar.running) then return "not running" end
    _G.vpnbar:stop()
    return "stopped"
  '
}

cmd_restart() {
  cmd_stop >/dev/null || true
  cmd_start
}

cmd_doctor() {
  local failures=0

  echo "Hammerspoon"
  if [ -d "${HAMMERSPOON_APP}" ]; then
    ok "installed"
  else
    bad "not installed — brew install --cask hammerspoon"
    failures=$((failures + 1))
  fi
  if pgrep -f 'Hammerspoon.app/Contents/MacOS' >/dev/null 2>&1; then
    ok "running"
  else
    bad "not running — open -a Hammerspoon"
    failures=$((failures + 1))
  fi

  echo "The Spoon"
  if spoon_link_is_live; then
    ok "linked into ${SPOONS}"
  elif spoon_is_stale_copy; then
    # Frozen at whatever it was when it was copied. Everything works and
    # nothing updates, which is worse than a clean break.
    bad "a copy, not a link — run: vpnbar link"
    note "${SPOONS}/VpnBar.spoon is a real directory, so brew upgrade"
    note "updates a copy of vpnbar that nothing is loading."
    failures=$((failures + 1))
  elif [ -L "${SPOONS}/VpnBar.spoon" ]; then
    bad "the link points at nothing — run: vpnbar link"
    note "$(printf '%s -> %s' "${SPOONS}/VpnBar.spoon" "$(readlink "${SPOONS}/VpnBar.spoon")")"
    failures=$((failures + 1))
  else
    bad "not linked — run: vpnbar link"
    failures=$((failures + 1))
  fi
  if [ -f "${INIT}" ] && grep -qF "${LOAD_MARK}" "${INIT}"; then
    ok "loaded from init.lua"
  else
    bad "init.lua does not load it — add: ${LOAD_LINE}"
    failures=$((failures + 1))
  fi

  echo "The menu bar"
  local frame="" hs_bin=""
  if hs_bin="$(find_hs)"; then
    frame="$(run_with_timeout 6 "${hs_bin}" -c 'local m = _G.vpnbar and _G.vpnbar.menubar; if not m then return "none" end local f = m:frame(); return string.format("%d %d", f.x, f.w)' 2>/dev/null | tail -1 || true)"
  fi
  case "${frame}" in
    "")
      note "cannot ask Hammerspoon — enable its command line with hs.ipc"
      ;;
    none)
      bad "not running inside Hammerspoon — run: vpnbar start"
      failures=$((failures + 1))
      ;;
    *)
      local x="${frame%% *}"
      if [ "${x}" -ge 0 ] 2>/dev/null; then
        ok "icon is on screen at x=${x}"
      else
        # This is the one nobody guesses. Bartender, Ice, Vanilla and the rest
        # hide an item by parking it at a large negative x. The item is running
        # and drawing; it is simply not where anyone can see it.
        bad "icon is parked off-screen at x=${x}"
        note "A menu bar manager is holding it there. Bartender knows it"
        note "as ${BARTENDER_ID} — a name"
        note "rather than an ordinal, because the Spoon gives its status"
        note "item an autosave name, so a decision about it sticks."
        note ""
        note "Show it now:"
        note "  osascript -e 'tell application \"Bartender 6\" \\"
        note "    to show \"${BARTENDER_ID}\"'"
        note ""
        note "To keep it, add that id to the manager's shown items. Ice"
        note "and Vanilla have the same idea under a different name."
        failures=$((failures + 1))
      fi
      ;;
  esac

  echo "Connections"
  local config="${HOME}/.config/vpnbar/profiles.json"
  if [ -f "${config}" ]; then
    ok "config at ${config}"
  else
    note "no config yet — the menu writes one when you add a connection"
  fi

  echo
  if [ "${failures}" -eq 0 ]; then
    echo "Nothing to fix."
  else
    echo "${failures} thing(s) to fix."
    exit 1
  fi
}

case "${1:-}" in
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  app) cmd_app ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  doctor) cmd_doctor ;;
  *)
    echo "usage: ${0##*/} start|stop|restart|link|unlink|app|doctor" >&2
    exit 2
    ;;
esac
