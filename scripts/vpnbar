#!/usr/bin/env bash
# The command line half of vpnbar: link the Spoon into Hammerspoon, take it out
# again, and say what is wrong when the icon is not where it should be.
#
# Homebrew installs the Spoon into its own prefix and must not write to a home
# directory, so linking is a separate step the user asks for. `doctor` exists
# because the first thing that goes wrong is not vpnbar at all — it is a menu
# bar manager holding the icon off-screen, which looks exactly like a program
# that failed to start.
set -euo pipefail

readonly SPOONS="${HOME}/.hammerspoon/Spoons"
# Overridable for the tests, which have no Hammerspoon to find.
readonly HAMMERSPOON_APP="${VPNBAR_HAMMERSPOON_APP:-/Applications/Hammerspoon.app}"
readonly INIT="${HOME}/.hammerspoon/init.lua"
readonly APP_DIR="${VPNBAR_APP_DIR:-${HOME}/Applications}"
readonly LOAD_LINE='hs.loadSpoon("VpnBar"):start()'
# What counts as "init.lua loads it". Matching the whole suggested line would
# call a config that keeps a handle on the Spoon — the two-line form — broken.
readonly LOAD_MARK='loadSpoon("VpnBar")'
# What a menu bar manager calls this icon: the application's bundle id plus the
# autosave name the Spoon gives its status item. Without that name it would be
# an ordinal, and an ordinal is not something a decision can stick to — see
# docs/adr/0016-the-menu-bar-item-has-a-name.md. Bartender 7 spells it
# "plist:status:<bundle>::<name>"; Bartender 6 spelled it "<bundle>-<name>".
readonly BARTENDER_ITEM="plist:status:org.hammerspoon.Hammerspoon::vpnbar"
# Bartender is addressed by bundle id so that its version, which is in the
# application's name ("Bartender 7"), is not in the command.
readonly BARTENDER_BUNDLE="com.surteesstudios.Bartender"

# `timeout` is GNU and not on a stock macOS. A Hammerspoon that is wedged, or
# whose ipc is off, must not hang the doctor.
run_with_timeout() {
  local seconds="$1"
  shift
  "$@" &
  local worker=$!
  # /bin/sleep by its path: this is the watchdog, and a sleep that returns at
  # once — a stub, a shim, anything on PATH — kills the command before it has
  # answered. The sleep runs as a child the watcher can kill on its way out,
  # because a TERM to the subshell does not reach a foreground sleep, and one
  # left counting to thirty holds every inherited file open — which is a
  # test runner waiting half a minute per call, and a caller of this script
  # doing the same. No inherited descriptors for the same reason.
  (
    /bin/sleep "${seconds}" &
    local napper=$!
    trap 'kill -TERM "${napper}" 2>/dev/null; exit 0' TERM
    wait "${napper}"
    kill -TERM "${worker}" 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  local watcher=$!
  wait "${worker}" 2>/dev/null
  local code=$?
  kill -TERM "${watcher}" 2>/dev/null
  wait "${watcher}" 2>/dev/null || true
  return "${code}"
}

# Homebrew puts a symlink in its bin and the real file in the Cellar, so the
# path this script was invoked by says nothing about where its Spoon is.
# Bounded, because a symlink cycle is an unbounded loop and this is a command
# somebody types. The Lua side already refuses to walk a cycle for the same
# reason — `findPressable` is depth-limited so an accessibility tree cannot hang
# Hammerspoon — and the shell half had no such limit. 32 is what the kernel
# allows before it gives up with ELOOP.
resolve_symlinks() {
  local target="$1" link hops=0
  while [ -L "${target}" ]; do
    hops=$((hops + 1))
    if [ "${hops}" -gt 32 ]; then
      echo "too many symlinks to follow from $1" >&2
      return 1
    fi
    link="$(readlink "${target}")"
    case "${link}" in
      /*) target="${link}" ;;
      *) target="$(dirname "${target}")/${link}" ;;
    esac
  done
  printf '%s\n' "${target}"
}

# Where the Spoon we install from lives.
#
# Homebrew first, by way of `brew --prefix vpnbar`, which answers with the
# stable `opt` path rather than the Cellar path carrying the version in it.
# Linking to the Cellar would leave a dangling symlink after the next upgrade,
# and a dangling Spoon is a menu bar with nothing in it and no error anywhere.
spoon_source() {
  local opt here
  opt="$(brew --prefix vpnbar 2>/dev/null || true)"
  if [ -n "${opt}" ] && [ -d "${opt}/libexec/VpnBar.spoon" ]; then
    printf '%s\n' "${opt}/libexec/VpnBar.spoon"
    return
  fi
  here="$(cd "$(dirname "$(resolve_symlinks "${BASH_SOURCE[0]}")")/.." && pwd)"
  if [ -d "${here}/VpnBar.spoon" ]; then
    printf '%s\n' "${here}/VpnBar.spoon"
  else
    printf '%s\n' "${here}/libexec/VpnBar.spoon"
  fi
}

# A link that points at nothing is one failure; a real directory sitting where
# the link belongs is the other, and it is the quieter one. A copy keeps working
# and stops tracking, so `brew upgrade` updates something nobody is running.
# Both are told apart here rather than by "is there a directory".
spoon_link_is_live() {
  [ -L "${SPOONS}/VpnBar.spoon" ] && [ -d "${SPOONS}/VpnBar.spoon/" ]
}

spoon_is_stale_copy() {
  [ ! -L "${SPOONS}/VpnBar.spoon" ] && [ -d "${SPOONS}/VpnBar.spoon" ]
}

ok() { printf '  ok    %s\n' "$1"; }
bad() { printf '  FAIL  %s\n' "$1"; }
note() { printf '        %s\n' "$1"; }

cmd_link() {
  local source
  source="$(spoon_source)"
  [ -d "${source}" ] || {
    echo "no VpnBar.spoon at ${source}" >&2
    exit 1
  }
  mkdir -p "${SPOONS}"
  # `ln -sfn` onto a real directory puts the link *inside* it, which is how a
  # copy survives being "relinked" and goes on being the code that runs. Take it
  # out first, and say so, because deleting a directory should never be silent.
  if spoon_is_stale_copy; then
    echo "replacing the copy at ${SPOONS}/VpnBar.spoon with a link"
    rm -rf "${SPOONS}/VpnBar.spoon"
  fi
  ln -sfn "${source}" "${SPOONS}/VpnBar.spoon"
  echo "linked ${SPOONS}/VpnBar.spoon -> ${source}"
  if [ -f "${INIT}" ] && grep -qF "${LOAD_MARK}" "${INIT}"; then
    echo "${INIT} already loads it"
  else
    echo
    echo "Add this to ${INIT} and reload Hammerspoon:"
    echo
    echo "    ${LOAD_LINE}"
  fi
  echo
  echo "For an icon in Launchpad and Spotlight: ${0##*/} app"
}

# Something to click. vpnbar is a Hammerspoon Spoon, so there has never been an
# icon in Launchpad or a name Spotlight could find, and when the menu bar item
# is gone there is nothing on the whole machine that looks like a way back in.
# This is the smallest bundle macOS will treat as an application: a launcher
# that runs `vpnbar start` and gets out of the way.
#
# LSUIElement, because it starts something else and exits. Without it the Dock
# shows a bouncing icon for a program that is already finished.
cmd_app() {
  local me app invoked
  invoked="${BASH_SOURCE[0]}"
  # Absolute, always: the Finder launches a bundle from a working directory that
  # has nothing to do with where this was invoked from, so a relative path here
  # produces an app that works when tested from the checkout and nowhere else.
  #
  # Absolute, but *not* resolved through its last symlink. /opt/homebrew/bin/vpnbar
  # points into the Cellar at a path carrying the version, and following it would
  # bake that version into the launcher; the next `brew upgrade` removes that keg
  # and leaves an app pointing at nothing. The same trap as linking the Spoon to
  # the Cellar instead of to opt.
  case "${invoked}" in
    /*) me="${invoked}" ;;
    */*) me="$(cd "$(dirname "${invoked}")" && pwd)/$(basename "${invoked}")" ;;
    *) me="$(command -v "${invoked}")" ;;
  esac
  app="${APP_DIR}/vpnbar.app"
  mkdir -p "${app}/Contents/MacOS"
  cat >"${app}/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>vpnbar</string>
  <key>CFBundleDisplayName</key><string>vpnbar</string>
  <key>CFBundleIdentifier</key><string>ch.sapn.vpnbar.launcher</string>
  <key>CFBundleExecutable</key><string>vpnbar</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
  cat >"${app}/Contents/MacOS/vpnbar" <<LAUNCHER
#!/usr/bin/env bash
# Written by \`vpnbar app\`. Starts the Spoon inside Hammerspoon and exits.
exec "${me}" start
LAUNCHER
  chmod +x "${app}/Contents/MacOS/vpnbar"
  # Without this the Finder can go on showing a bundle it has already cached.
  touch "${app}"
  echo "installed ${app}"
  echo "It runs: ${me} start"
}

cmd_unlink() {
  # -f alone cannot remove a directory, so a stale copy survived `unlink` and
  # went on being loaded by Hammerspoon.
  rm -rf "${SPOONS}/VpnBar.spoon"
  echo "removed ${SPOONS}/VpnBar.spoon"
  if [ -d "${APP_DIR}/vpnbar.app" ]; then
    rm -rf "${APP_DIR}/vpnbar.app"
    echo "removed ${APP_DIR}/vpnbar.app"
  fi
  echo "The line in ${INIT} is left alone; take it out by hand."
}

# `hs` lives inside the Hammerspoon bundle and is only on PATH because something
# put a symlink there. An app launched from the Finder gets
# /usr/bin:/bin:/usr/sbin:/sbin and nothing else, so looking it up on PATH alone
# is a launcher that works from a terminal and silently does nothing when
# double-clicked. The bundle is the location that does not depend on a shell
# profile, so it is asked first.
find_hs() {
  local candidate
  # An explicit answer wins over any search. The tests set it, because a search
  # that reaches an absolute path finds the real Hammerspoon on a developer's
  # machine and a "test" then starts the menu somebody is actually using.
  if [ -n "${VPNBAR_HS:-}" ]; then
    [ -x "${VPNBAR_HS}" ] || return 1
    printf '%s\n' "${VPNBAR_HS}"
    return 0
  fi
  for candidate in \
    "${HAMMERSPOON_APP}/Contents/Frameworks/hs/hs" \
    /opt/homebrew/bin/hs \
    /usr/local/bin/hs; do
    [ -x "${candidate}" ] && {
      printf '%s\n' "${candidate}"
      return 0
    }
  done
  command -v hs 2>/dev/null && return 0
  return 1
}

# Asking Hammerspoon to do something, with the same timeout the doctor uses: a
# wedged Hammerspoon must not hang a command somebody typed to fix it.
#
# The answer comes back in a variable rather than down a pipe. Through a pipe
# the reporting half runs in a subshell, so its `exit 1` ends the subshell and
# the script carries on as if the command had worked.
# The second argument is the budget in seconds, default ten. Killing `hs`
# while Hammerspoon is still running the script is not free: the reply port
# dies, the next print inside that script throws, and a script that has
# already dropped the old modules then loads nothing. So a start gets longer.
#
# `-A` on every call. Without it the client asks LaunchServices whether
# Hammerspoon is running before it touches the port, and when that answer is
# empty — which it is now and then for a process that is plainly there — it
# puts up a modal "launch it now?" alert that no timeout covers and sits in it
# until killed. With it the client launches Hammerspoon without activation, a
# no-op when it is running, and polls the port instead. See ADR 0025.
ask_hammerspoon() {
  local hs_bin answer budget="${2:-10}"
  hs_bin="$(find_hs)" || {
    echo "Hammerspoon's command line is missing. Run this in the" >&2
    echo "Hammerspoon console:" >&2
    echo >&2
    echo "    hs.ipc.cliInstall()" >&2
    return 1
  }
  answer="$(run_with_timeout "${budget}" "${hs_bin}" -A -c "$1" 2>/dev/null | tail -1)"
  case "${answer}" in
    FAIL*)
      echo "${answer#FAIL }" >&2
      return 1
      ;;
    "")
      echo "no answer from Hammerspoon" >&2
      return 1
      ;;
    *)
      printf '%s\n' "${answer}"
      ;;
  esac
}

# Does Hammerspoon's command line answer *right now*? The process existing is
# not the same question: after `open`, Hammerspoon is in the process table well
# before ipc is listening, so waiting on pgrep alone returns a moment too early
# and the first real request comes back empty — "no answer from Hammerspoon" on
# an ordinary cold start.
# The optional argument is the budget in seconds, default three.
hammerspoon_answers() {
  local hs_bin budget="${1:-3}"
  hs_bin="$(find_hs)" || return 1
  [ -n "$(run_with_timeout "${budget}" "${hs_bin}" -A -c 'return "up"' 2>/dev/null | tail -1)" ]
}

# Hammerspoon has to be up *and answering* before it can be asked anything.
ensure_hammerspoon() {
  hammerspoon_answers && return 0
  if ! pgrep -f 'Hammerspoon.app/Contents/MacOS' >/dev/null 2>&1; then
    [ -d "${HAMMERSPOON_APP}" ] || {
      echo "Hammerspoon is not installed — brew install --cask hammerspoon" >&2
      return 1
    }
    echo "starting Hammerspoon"
    open -a "${HAMMERSPOON_APP}"
  fi
  local waited=0
  while [ "${waited}" -lt 20 ]; do
    hammerspoon_answers && return 0
    sleep 1
    waited=$((waited + 1))
  done
  echo "Hammerspoon did not come up within 20 seconds" >&2
  echo "If it is running, its command line may be off — in the console:" >&2
  echo >&2
  echo "    hs.ipc.cliInstall()" >&2
  return 1
}

# `Quit vpnbar` stops the Spoon and leaves Hammerspoon running, which is the
# whole point of it — Hammerspoon is doing other jobs on this machine. Until
# these verbs existed the only way back was reloading Hammerspoon and every
# other config with it, so the menu had a way out and no way in.
# How long the fallback may take, all in: the reload request and every check
# after it, against one wall clock. Overridable so a test need not wait.
readonly RELOAD_BUDGET="${VPNBAR_RELOAD_BUDGET:-30}"

# The proven way in, when the surgical one fails: reload Hammerspoon, then
# confirm the Spoon came back rather than assume it. Used only as a fallback,
# because it reloads every other config Hammerspoon holds as well.
#
# One deadline for the whole thing. The reload request goes through the
# watchdog like every other call — a Hammerspoon that has stopped answering is
# the case the watchdog exists for, and it is a plausible reason to be here —
# and each check afterwards gets at most what is left, so thirty loops of
# three-second probes cannot quietly become two minutes.
start_by_reloading() {
  local hs_bin deadline remaining per
  hs_bin="$(find_hs)" || return 1
  deadline=$(( $(date +%s) + RELOAD_BUDGET ))
  run_with_timeout 5 "${hs_bin}" -A -c 'hs.timer.doAfter(0.5, hs.reload)' >/dev/null 2>&1 || true
  while :; do
    remaining=$(( deadline - $(date +%s) ))
    [ "${remaining}" -gt 0 ] || break
    sleep 1
    remaining=$(( deadline - $(date +%s) ))
    per=$(( remaining < 5 ? remaining : 5 ))
    [ "${per}" -gt 0 ] || break
    if hammerspoon_answers "${per}" \
      && [ "$(run_with_timeout "${per}" "${hs_bin}" -A -c 'return tostring(_G.vpnbar and _G.vpnbar.running)' 2>/dev/null | tail -1)" = "true" ]; then
      echo "started, by reloading Hammerspoon"
      return 0
    fi
  done
  echo "Hammerspoon was reloaded but vpnbar did not come back within ${RELOAD_BUDGET} seconds; check ${INIT}" >&2
  return 1
}

cmd_start() {
  ensure_hammerspoon || exit 1
  local answer
  if answer="$(start_in_place)"; then
    printf '%s\n' "${answer}"
    return 0
  fi
  # Loading in place can fail after the old modules are already gone, which
  # leaves nothing running — seen once, when a print inside hs.loadSpoon hit a
  # dead port left behind by a CLI call that had been killed. A start that
  # says "could not load" and walks away is worse than the reload it was
  # trying to avoid.
  echo "the Spoon would not load in place; reloading Hammerspoon instead" >&2
  start_by_reloading
}

start_in_place() {
  # The cached modules are dropped before the Spoon is loaded. hs.loadSpoon
  # returns whatever is already in spoon.VpnBar, and require returns whatever
  # is already in package.loaded, so a start after brew upgrade ran the code
  # from before the upgrade — every time, on every upgrade so far — and only a
  # full hs.reload, with every other config in it, brought the installed code
  # in. Nothing loaded is lost: a running Spoon returns before this, and a
  # stopped one holds nothing worth keeping.
  #
  # Two spellings, because there are two caches. The Spoon itself is loaded
  # by hs.loadSpoon through require("VpnBar"), so its init.lua sits under
  # "VpnBar"; the modules it requires sit under "vpnbar.*". The first version
  # of this dropped only the lowercase ones and would have gone on running the
  # old init.lua with fresh modules underneath it.
  ask_hammerspoon '
    if _G.vpnbar and _G.vpnbar.running then return "already running" end
    for name in pairs(package.loaded) do
      if name == "VpnBar" or name == "vpnbar" or name:sub(1, 7) == "vpnbar." then package.loaded[name] = nil end
    end
    spoon.VpnBar = nil
    local ok, loaded = pcall(hs.loadSpoon, "VpnBar")
    if not ok or not loaded then return "FAIL could not load the Spoon: " .. tostring(loaded) end
    _G.vpnbar = loaded:start()
    return _G.vpnbar.running and "started" or "FAIL start did not take"
  ' 30
}

cmd_stop() {
  ask_hammerspoon '
    if not (_G.vpnbar and _G.vpnbar.running) then return "not running" end
    _G.vpnbar:stop()
    return "stopped"
  '
}

cmd_restart() {
  cmd_stop >/dev/null || true
  cmd_start
}

# What Bartender says about the icon: "visible", "hidden", "unlisted" when it
# answers but has never seen the item, and nothing when no Bartender is running
# or it does not answer. Bartender 7 lists its items as JSON objects whose key
# order is not fixed, so the object is found by the id and the state read off
# that same object.
bartender_state() {
  pgrep -f '/Bartender[^/]*\.app/Contents/MacOS/' >/dev/null 2>&1 || return 0
  local details object
  details="$(run_with_timeout 6 osascript -e "tell application id \"${BARTENDER_BUNDLE}\" to list menu bar item details" 2>/dev/null || true)"
  [ -n "${details}" ] || return 0
  object="$(printf '%s' "${details}" | tr '}' '\n' | grep -F "\"id\":\"${BARTENDER_ITEM}\"" | head -n 1)"
  case "${object}" in
    *'"state":"'*)
      object="${object#*\"state\":\"}"
      printf '%s\n' "${object%%\"*}"
      ;;
    *) echo unlisted ;;
  esac
}

# ---------------------------------------------------------- the tunnel itself
#
# What a VPN leaves behind when it dies badly. The routes it installed outlive
# the interface they point at, so every address it had claimed goes to a tunnel
# that is not carrying anything: the machine looks connected and reaches
# nothing. Only a reboot cleared it the first time this happened, which is the
# reason these two live here — see
# docs/adr/0033-stopping-an-agent-that-launchd-restarts.md.

# Tunnel interfaces that are not up. An address outlives the tunnel it belonged
# to, so the address is no evidence; the UP flag is.
tunnel_interfaces_down() {
  # Not every machine this script is tested on has these; a missing command is
  # "nothing to report", never a doctor that stops half way through.
  command -v ifconfig >/dev/null 2>&1 || return 0
  ifconfig -a 2>/dev/null | awk '
    /^[a-zA-Z0-9]+:/ {
      name = $1
      sub(/:$/, "", name)
      up = 0
      if (match($0, /<[^>]*>/)) {
        flags = "," substr($0, RSTART + 1, RLENGTH - 2) ","
        if (index(flags, ",UP,") > 0) { up = 1 }
      }
      if (name ~ /^utun[0-9]+$/ && up == 0) { print name }
    }
  '
}

# Tunnel interfaces that are up, which is the other half of the same question.
# A route on one of these is a route a tunnel is using now, so it is never a
# leftover and the rule that removes it has to be about what it covers.
tunnel_interfaces_up() {
  command -v ifconfig >/dev/null 2>&1 || return 0
  ifconfig -a 2>/dev/null | awk '
    /^[a-zA-Z0-9]+:/ {
      name = $1
      sub(/:$/, "", name)
      up = 0
      if (match($0, /<[^>]*>/)) {
        flags = "," substr($0, RSTART + 1, RLENGTH - 2) ","
        if (index(flags, ",UP,") > 0) { up = 1 }
      }
      if (name ~ /^utun[0-9]+$/ && up == 1) { print name }
    }
  '
}

# Every route bound to one of those, as `family|destination|gateway|flags|netif`.
#
# Bounded twice on purpose: the interface has to be a tunnel, and that tunnel
# has to be down. A route table is the one file on a machine where a wrong
# delete is indistinguishable from pulling the cable out.
stale_routes() {
  command -v netstat >/dev/null 2>&1 || return 0
  local down
  down="$(tunnel_interfaces_down | tr '\n' ' ')"
  [ -n "${down# }" ] || return 0
  local family
  for family in inet inet6; do
    netstat -rn -f "${family}" 2>/dev/null | awk -v down=" ${down} " -v family="${family}" '
      NF >= 4 && $4 ~ /^utun[0-9]+$/ && index(down, " " $4 " ") > 0 {
        printf "%s|%s|%s|%s|%s\n", family, $1, $2, $3, $4
      }
    '
  done
}

# The whole of the private address space, as netstat spells it and as anybody
# would write it.
#
# An enumeration, not a pattern. "Starts with 10." matches 10.241.168/23, which
# is a prefix the tunnel is entitled to and which this list ends in a delete
# for. Only the three aggregates themselves are in it.
#
# IPv4 only. The equivalent in IPv6 would be the unique local prefixes, and no
# tunnel on this machine has been measured claiming one, so nothing here
# pretends to know what that looks like.
readonly CLAIMED_AGGREGATES='10 10/8 10.0.0.0/8 172.16/12 172.16.0.0/12 192.168/16 192.168.0/16 192.168.0.0/16'

# The network and mask one of those spellings resolves to.
#
# `route -n get` answers "which route did you use" with a network and a mask,
# and the table spells the same prefix several ways, so the two have to be
# matched up before a resolver's route can be compared with an aggregate's.
# Every entry of `CLAIMED_AGGREGATES` has to be in here; a test asserts that,
# because a new spelling added to one and not the other would silently stop
# pinning resolvers.
#
# The mask is half of the answer because the network address is not enough: a
# tunnel carrying both `10/8` and a `10.0.0.0/24` answers `destination:
# 10.0.0.0` for either, and the narrower one is the route that would have kept
# a resolver behind it.
aggregate_route() {
  case "$1" in
    10 | 10/8 | 10.0.0.0/8) echo "10.0.0.0|255.0.0.0" ;;
    172.16/12 | 172.16.0.0/12) echo "172.16.0.0|255.240.0.0" ;;
    192.168/16 | 192.168.0/16 | 192.168.0.0/16) echo "192.168.0.0|255.255.0.0" ;;
    *) return 1 ;;
  esac
}

# Every resolver the system is configured with, once each.
configured_resolvers() {
  command -v scutil >/dev/null 2>&1 || return 0
  scutil --dns 2>/dev/null | awk '
    match($0, /nameserver\[[0-9]+\][[:space:]]*:[[:space:]]*/) {
      print substr($0, RSTART + RLENGTH)
    }
  ' | sort -u
}

# Where the kernel sends one address right now, as `destination|mask|netif`.
#
# Asked of the kernel rather than worked out from the table: the answer already
# accounts for every more specific route, so a resolver the tunnel covers with a
# narrow prefix of its own reports that prefix and not the aggregate.
#
# No gateway. Measured on this machine: `route -n get` prints a `gateway:` line
# for a route that has one and leaves it out for an interface route, and plenty
# of tunnel clients install their routes in that second form. Requiring one
# meant those resolvers came back as nothing at all and were skipped in silence,
# which is this rule's own fault arrived at from the other side. The mask is the
# better discriminator anyway, and a net route always has one.
route_to() {
  command -v route >/dev/null 2>&1 || return 0
  route -n get "$1" 2>/dev/null | awk '
    /^[[:space:]]*destination:/ { destination = $2 }
    /^[[:space:]]*mask:/ { mask = $2 }
    /^[[:space:]]*interface:/ { netif = $2 }
    END {
      if (destination != "" && mask != "" && netif != "") {
        printf "%s|%s|%s\n", destination, mask, netif
      }
    }
  '
}

# `resolver|gateway|netif` for every configured resolver that is reaching its
# tunnel through one of the aggregates that is about to go.
#
# This is the whole reason the aggregates cannot simply be deleted. A client
# that asks for all of `10.0.0.0/8` usually puts its resolvers in there too, and
# removing the aggregate takes the way to them with it: every name stops
# resolving, which is worse than the fault being fixed. Measured on 16.10.2026,
# where `dig` went to `connection timed out` the moment `10` was gone.
#
# A resolver on the LAN is never in this list, because its route is on a
# physical interface. One the tunnel covers with a narrower prefix is not in it
# either, because that prefix stays.
resolvers_behind() {
  local routes="$1"
  local resolver where destination mask netif
  local family rdest gateway flags rnetif prefix
  while IFS= read -r resolver; do
    [ -n "${resolver}" ] || continue
    where="$(route_to "${resolver}")"
    [ -n "${where}" ] || continue
    IFS='|' read -r destination mask netif <<EOF
${where}
EOF
    while IFS='|' read -r family rdest gateway flags rnetif; do
      [ -n "${family}" ] || continue
      [ "${rnetif}" = "${netif}" ] || continue
      prefix="$(aggregate_route "${rdest}")" || continue
      [ "${prefix}" = "${destination}|${mask}" ] || continue
      printf '%s|%s|%s\n' "${resolver}" "${gateway}" "${netif}"
      break
    done <<EOF
${routes}
EOF
  done < <(configured_resolvers)
}

# The `route` call that pins one resolver to the tunnel it was already using.
#
# A gateway that is a link address belongs to no address family anybody can
# name, so those go by interface, for the same reason `route_delete_args` does
# it. An aggregate installed as an interface route has no gateway to pass at all.
route_add_host() {
  local address="$1" gateway="$2" netif="$3"
  case "${gateway}" in
    "" | link#* | "${netif}")
      sudo route -n add -inet -host "${address}" -interface "${netif}"
      ;;
    *)
      sudo route -n add -inet -host "${address}" "${gateway}"
      ;;
  esac
}

# Every aggregate route a tunnel that is up has claimed, in the same
# `family|destination|gateway|flags|netif` shape.
#
# This is the other way a route table stops working, and it is the opposite
# case to the one above: the tunnel is alive and the routes are real. What makes
# them wrong is their width. A client that asks for all of private space takes
# the network the machine is physically on with it, so a host one subnet over, a
# printer or a Pi at home is unreachable for as long as the VPN is up, with
# nothing in the table looking broken.
claimed_routes() {
  command -v netstat >/dev/null 2>&1 || return 0
  local up
  up="$(tunnel_interfaces_up | tr '\n' ' ')"
  [ -n "${up# }" ] || return 0
  netstat -rn -f inet 2>/dev/null | awk -v up=" ${up} " -v wanted=" ${CLAIMED_AGGREGATES} " '
    NF >= 4 && $4 ~ /^utun[0-9]+$/ && index(up, " " $4 " ") > 0 && index(wanted, " " $1 " ") > 0 {
      printf "inet|%s|%s|%s|%s\n", $1, $2, $3, $4
    }
  '
}

# The `route` call that removes one of them.
#
# A gateway that is a link address belongs to no address family anybody can
# name, so those go by interface. Everything else goes by its own gateway,
# which is what makes the delete specific rather than a prefix nobody checked.
route_delete_args() {
  local family="$1" destination="$2" gateway="$3" flags="$4" netif="$5"
  local kind="-net"
  case "${flags}" in *H*) kind="-host" ;; esac
  case "${gateway}" in
    link#* | "${netif}")
      printf '%s\n' "-n" "delete" "-${family}" "${kind}" "${destination}" "-interface" "${netif}"
      ;;
    *)
      printf '%s\n' "-n" "delete" "-${family}" "${kind}" "${destination}" "${gateway}"
      ;;
  esac
}

# One argument per line, so the command is run as a list rather than as a
# string somebody has to word-split. A destination with a space in it is not a
# thing, but a delete assembled by `$(...)` is one typo away from being a
# different delete.
route_delete() {
  local -a arguments=()
  local argument
  while IFS= read -r argument; do
    arguments+=("${argument}")
  done < <(route_delete_args "$@")
  sudo route "${arguments[@]}"
}

# A VPN installs its own resolvers while it is up. GlobalProtect writes
# State:/Network/Service/gpd.pan/DNS with the internal servers and the search
# domains, and those servers answer through the tunnel and nowhere else. When
# the tunnel dies without the client tidying up, every internal name stops
# resolving and every lookup that reaches them waits for a timeout, which is a
# machine that looks online and cannot find anything.

# Seconds a resolver is given to answer before it counts as gone.
readonly DNS_PROBE_WAIT=1

# The VPN services whose resolvers may be removed, by name.
#
# An enumeration rather than a rule. "Not a UUID" says only that macOS did not
# number it, which is true of anything that installed itself, and removing some
# other program's resolvers because they happened not to answer is a fault of
# its own. These are the two clients this tool drives, and a name that is not
# here is left alone however dead it looks.
readonly VPN_DNS_SERVICES="gpd.pan"


# The services a VPN added, which are the ones named rather than numbered.
#
# macOS names its own network services with a UUID. Anything else in that
# position was put there by something that installed itself, and those are the
# only ones this touches: removing a real service's resolvers would take the
# machine off the network it is still on.
vpn_dns_services() {
  command -v scutil >/dev/null 2>&1 || return 0
  scutil <<<"list" 2>/dev/null | awk -v known="${VPN_DNS_SERVICES}" '
    match($0, /State:\/Network\/Service\/[^\/]+\/DNS/) {
      key = substr($0, RSTART, RLENGTH)
      name = key
      sub(/^State:\/Network\/Service\//, "", name)
      sub(/\/DNS$/, "", name)
      if (name !~ /^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$/ \
        && index(" " known " ", " " name " ") > 0) {
        print name
      }
    }
  '
}

# The resolvers one of those services installed.
dns_servers_of() {
  local service="$1"
  scutil <<<"show State:/Network/Service/${service}/DNS" 2>/dev/null | awk '
    /ServerAddresses/ { inside = 1; next }
    inside && /^[[:space:]]*}/ { inside = 0 }
    inside && match($0, /[0-9a-fA-F.:]+$/) { print substr($0, RSTART, RLENGTH) }
  '
}

# Does any of them answer a question?
#
# A real query, not an open port. `nc -z` says only that something accepted a
# TCP connection: a resolver that listens and answers nothing passes it, and a
# working resolver that takes queries on UDP alone fails it. Either way round it
# would be authorising a removal on the wrong evidence.
#
# The question is the one every resolver can answer, bounded to a second and a
# single try, and `dig` is on every macOS. Where it is missing nothing is
# reported, because an answer nobody could ask for is not evidence of anything.
dns_reachable() {
  command -v dig >/dev/null 2>&1 || return 0
  local server
  for server in "$@"; do
    if dig +time="${DNS_PROBE_WAIT}" +tries=1 +short "@${server}" . NS >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

# `service|server,server` for every VPN service whose resolvers have all gone.
stale_dns() {
  local service servers
  while IFS= read -r service; do
    [ -n "${service}" ] || continue
    servers="$(dns_servers_of "${service}" | tr '\n' ' ')"
    servers="${servers% }"
    [ -n "${servers}" ] || continue
    # shellcheck disable=SC2086
    if ! dns_reachable ${servers}; then
      printf '%s|%s\n' "${service}" "${servers}"
    fi
  done < <(vpn_dns_services)
}

clean_routes() {
  local dry="$1" assume_yes="$2"
  local routes
  routes="$(stale_routes)"
  if [ -z "${routes}" ]; then
    echo "No routes point at a tunnel that is down."
    return 0
  fi

  local count
  count="$(printf '%s\n' "${routes}" | wc -l | tr -d ' ')"
  echo "${count} route(s) point at a tunnel that is down:"
  local family destination gateway flags netif
  while IFS='|' read -r family destination gateway flags netif; do
    [ -n "${family}" ] || continue
    printf '  %-6s %-22s via %-22s %s\n' "${family}" "${destination}" "${gateway}" "${netif}"
  done <<EOF
${routes}
EOF

  if [ "${dry}" -eq 1 ]; then
    echo
    echo "What it would run:"
    while IFS='|' read -r family destination gateway flags netif; do
      [ -n "${family}" ] || continue
      printf '  sudo route %s\n' "$(route_delete_args "${family}" "${destination}" "${gateway}" "${flags}" "${netif}" | tr '\n' ' ')"
    done <<EOF
${routes}
EOF
    return 0
  fi

  if [ "${assume_yes}" -ne 1 ]; then
    printf 'Delete them? [y/N] '
    local answer=""
    read -r answer </dev/tty || true
    case "${answer}" in
      y | Y | yes | YES) ;;
      *)
        echo "Left alone."
        return 0
        ;;
    esac
  fi

  # One `sudo` for the lot, so the password is asked for once.
  local failures=0
  sudo -v || true
  while IFS='|' read -r family destination gateway flags netif; do
    [ -n "${family}" ] || continue
    if route_delete "${family}" "${destination}" "${gateway}" "${flags}" "${netif}" >/dev/null 2>&1; then
      printf '  gone  %s %s\n' "${destination}" "${netif}"
    else
      printf '  kept  %s %s (the route command refused it)\n' "${destination}" "${netif}"
      failures=$((failures + 1))
    fi
  done <<EOF
${routes}
EOF

  local left
  left="$(stale_routes | wc -l | tr -d ' ')"
  echo
  if [ "${left}" = "0" ]; then
    echo "The route table is clean."
  else
    echo "${left} route(s) are still there."
    note "A tunnel whose system extension has stopped answering keeps its"
    note "routes until the machine reboots. vpnbar doctor says whether that"
    note "is what this is."
    return 1
  fi
  [ "${failures}" -eq 0 ] || return 1
  return 0
}

# Take the private address space back off a tunnel that is up.
#
# Separate from `clean_routes` rather than folded into it, because the two
# answer different questions and only one of them is safe to run without being
# asked. A route to a dead interface helps nobody; a route into a live tunnel is
# a client doing what it was configured to do, and removing it is a choice about
# which network matters more right now.
clean_claimed() {
  local dry="$1" assume_yes="$2"
  local routes
  routes="$(claimed_routes)"
  if [ -z "${routes}" ]; then
    echo "No live tunnel has claimed the private address space."
    return 0
  fi

  local count
  count="$(printf '%s\n' "${routes}" | wc -l | tr -d ' ')"
  echo "${count} route(s) send the private address space into a live tunnel:"
  local family destination gateway flags netif
  while IFS='|' read -r family destination gateway flags netif; do
    [ -n "${family}" ] || continue
    printf '  %-6s %-22s via %-22s %s\n' "${family}" "${destination}" "${gateway}" "${netif}"
  done <<EOF
${routes}
EOF
  note "Everything they cover goes to the tunnel instead of the network this"
  note "machine is on, so a host one subnet over, a printer or a Pi at home is"
  note "unreachable while the VPN is up."
  note "An internal prefix inside them goes the same way. The tunnel keeps"
  note "every route of its own that is more specific than these."

  local pinned resolver pinGateway pinNetif
  pinned="$(resolvers_behind "${routes}")"
  if [ -n "${pinned}" ]; then
    echo
    echo "These resolvers are reaching the tunnel through them, and are pinned first:"
    while IFS='|' read -r resolver pinGateway pinNetif; do
      [ -n "${resolver}" ] || continue
      printf '  %-22s via %-22s %s\n' "${resolver}" "${pinGateway}" "${pinNetif}"
    done <<EOF
${pinned}
EOF
    note "A host route each, added before anything is deleted, so there is no"
    note "moment in which no name resolves."
  fi

  if [ "${dry}" -eq 1 ]; then
    echo
    echo "What it would run:"
    while IFS='|' read -r resolver pinGateway pinNetif; do
      [ -n "${resolver}" ] || continue
      case "${pinGateway}" in
        "" | link#* | "${pinNetif}")
          printf '  sudo route -n add -inet -host %s -interface %s\n' "${resolver}" "${pinNetif}"
          ;;
        *) printf '  sudo route -n add -inet -host %s %s\n' "${resolver}" "${pinGateway}" ;;
      esac
    done <<EOF
${pinned}
EOF
    while IFS='|' read -r family destination gateway flags netif; do
      [ -n "${family}" ] || continue
      printf '  sudo route %s\n' "$(route_delete_args "${family}" "${destination}" "${gateway}" "${flags}" "${netif}" | tr '\n' ' ')"
    done <<EOF
${routes}
EOF
    return 0
  fi

  if [ "${assume_yes}" -ne 1 ]; then
    printf 'Delete them? [y/N] '
    local answer=""
    read -r answer </dev/tty || true
    case "${answer}" in
      y | Y | yes | YES) ;;
      *)
        echo "Left alone."
        return 0
        ;;
    esac
  fi

  local failures=0 unpinned=0
  sudo -v || true
  # First, so the window in which a resolver has no route is never opened. A
  # host route is more specific than the aggregate and the two coexist.
  while IFS='|' read -r resolver pinGateway pinNetif; do
    [ -n "${resolver}" ] || continue
    if route_add_host "${resolver}" "${pinGateway}" "${pinNetif}" >/dev/null 2>&1; then
      printf '  kept  %s via %s\n' "${resolver}" "${pinNetif}"
    else
      printf '  lost  %s (the route command refused the host route)\n' "${resolver}"
      unpinned=$((unpinned + 1))
      failures=$((failures + 1))
    fi
  done <<EOF
${pinned}
EOF
  # A resolver that could not be pinned would lose its only route along with
  # the aggregate, which is the fault this whole rule exists to prevent. So
  # nothing is deleted: the local network stays broken, which is the lesser of
  # the two, and the report says which resolver stopped it.
  if [ "${unpinned}" -ne 0 ]; then
    echo
    echo "Nothing was deleted."
    note "${unpinned} resolver(s) could not be pinned, and the aggregate is"
    note "their only route. Fixing the local network is not worth taking DNS"
    note "down to do it."
    return 1
  fi
  while IFS='|' read -r family destination gateway flags netif; do
    [ -n "${family}" ] || continue
    if route_delete "${family}" "${destination}" "${gateway}" "${flags}" "${netif}" >/dev/null 2>&1; then
      printf '  gone  %s %s\n' "${destination}" "${netif}"
    else
      printf '  kept  %s %s (the route command refused it)\n' "${destination}" "${netif}"
      failures=$((failures + 1))
    fi
  done <<EOF
${routes}
EOF

  # Asked with a real query, because a host route that exists and a resolver
  # that answers are two different claims, and the second is the one that
  # matters. This is the check that was missing when `10` first came off and
  # `dig` went to a timeout.
  if [ -n "${pinned}" ]; then
    # One at a time. `dns_reachable` is satisfied by any one server answering,
    # which is the right question for "is this service still there" and the
    # wrong one here: a resolver that went silent is hidden by a neighbour that
    # did not.
    local silent="" quiet=""
    while IFS='|' read -r resolver pinGateway pinNetif; do
      [ -n "${resolver}" ] || continue
      if ! dns_reachable "${resolver}"; then
        silent="${silent} ${resolver}"
        quiet="${quiet}${resolver}|${pinGateway}|${pinNetif}
"
      fi
    done <<EOF
${pinned}
EOF
    if [ -z "${silent}" ]; then
      echo "  ok    every pinned resolver still answers"
    else
      echo "  FAIL  no answer from:${silent}"
      # The command itself, per resolver, because the two forms are not
      # interchangeable: an aggregate installed as an interface route has no
      # gateway to pass, and a hint that said `<gateway>` would be a command
      # that fails or, worse, one that picks some other next hop.
      note "Put them back with:"
      while IFS='|' read -r resolver pinGateway pinNetif; do
        [ -n "${resolver}" ] || continue
        case "${pinGateway}" in
          "" | link#* | "${pinNetif}")
            note "  sudo route -n add -inet -host ${resolver} -interface ${pinNetif}"
            ;;
          *) note "  sudo route -n add -inet -host ${resolver} ${pinGateway}" ;;
        esac
      done <<EOF
${quiet}
EOF
      note "and say so, because this rule was written to stop exactly this."
      failures=$((failures + 1))
    fi
  fi

  local left
  left="$(claimed_routes | wc -l | tr -d ' ')"
  echo
  if [ "${left}" = "0" ]; then
    echo "The private address space is local again."
  else
    echo "${left} route(s) are still there."
    note "A client that reinstalls them on every reconnect puts them back. The"
    note "fix for that one is the profile, not the route table."
    return 1
  fi
  [ "${failures}" -eq 0 ] || return 1
  return 0
}

# Resolvers a VPN installed and never took away.
clean_dns() {
  local dry="$1" assume_yes="$2"
  local stale
  stale="$(stale_dns)"
  if [ -z "${stale}" ]; then
    echo "No resolvers are left over from a VPN that is gone."
    return 0
  fi

  local service servers
  echo "These resolvers answer nothing:"
  while IFS='|' read -r service servers; do
    [ -n "${service}" ] || continue
    printf '  %-18s %s\n' "${service}" "${servers}"
  done <<EOF
${stale}
EOF
  note "Until they go, every name they were meant to resolve fails and every"
  note "lookup that reaches them waits for a timeout."

  if [ "${dry}" -eq 1 ]; then
    echo
    echo "What it would run:"
    while IFS='|' read -r service servers; do
      [ -n "${service}" ] || continue
      printf '  sudo scutil <<< "remove State:/Network/Service/%s/DNS"\n' "${service}"
      printf '  sudo scutil <<< "remove Setup:/Network/Service/%s/DNS"\n' "${service}"
    done <<EOF
${stale}
EOF
    return 0
  fi

  if [ "${assume_yes}" -ne 1 ]; then
    printf 'Remove them? [y/N] '
    local answer=""
    read -r answer </dev/tty || true
    case "${answer}" in
      y | Y | yes | YES) ;;
      *)
        echo "Left alone."
        return 0
        ;;
    esac
  fi

  sudo -v || true
  local failures=0
  while IFS='|' read -r service servers; do
    [ -n "${service}" ] || continue
    if printf 'remove State:/Network/Service/%s/DNS\nremove Setup:/Network/Service/%s/DNS\nquit\n' \
      "${service}" "${service}" | sudo scutil >/dev/null 2>&1; then
      printf '  gone  %s\n' "${service}"
    else
      printf '  kept  %s (scutil refused it)\n' "${service}"
      failures=$((failures + 1))
    fi
  done <<EOF
${stale}
EOF
  [ "${failures}" -eq 0 ] || return 1
  return 0
}

cmd_clean() {
  local dry=0 assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --yes | -y) assume_yes=1 ;;
      *)
        echo "usage: ${0##*/} clean [--dry-run] [--yes]" >&2
        exit 2
        ;;
    esac
    shift
  done

  local trouble=0
  clean_routes "${dry}" "${assume_yes}" || trouble=1
  echo
  clean_claimed "${dry}" "${assume_yes}" || trouble=1
  echo
  clean_dns "${dry}" "${assume_yes}" || trouble=1
  [ "${trouble}" -eq 0 ] || exit 1
}

# ------------------------------------------------------------- is it online
#
# The question nothing here was asking. A tethered Mac whose phone had switched
# its own data off looked, from the inside, exactly like a working machine: the
# Wi-Fi was joined, a default route was installed, the phone answered every
# packet addressed to it, and nothing beyond it existed. `vpnbar doctor` said
# everything was in place, which was true of everything it looked at.

# Seconds each of these is given. Short on purpose: this runs ahead of every
# other check and a doctor nobody waits for is a doctor nobody runs.
readonly UPLINK_WAIT=3

# The endpoint macOS itself asks whether this machine is on the internet.
#
# Apple's captive-portal probe, which every Mac polls on its own whenever a
# network changes. Asking it once more names nobody new and sends nothing about
# the machine. What it serves is one short page whose title is `Success`, which
# is what makes a captive portal visible rather than merely absent: a portal
# answers, and answers something different.
readonly UPLINK_PROBE='http://captive.apple.com/hotspot-detect.html'

# Its name, looked up on its own before the page is asked for.
#
# Otherwise a resolver that has stopped answering spends the whole of
# `--max-time` inside the lookup and `curl` reports a timeout, which is
# indistinguishable from a gateway with nothing behind it. The lookup is the
# part that has to be asked separately, because this script knows two ways for
# it to be the fault.
readonly UPLINK_HOST='captive.apple.com'

# The title, not the bare word. A portal's own page can carry "Success" in its
# prose — a sign-in form that says it will tell you on success — and a portal
# read as reachable is the one answer this must never give.
readonly UPLINK_SUCCESS='<TITLE>Success</TITLE>'

# The first hop off this machine, or nothing.
default_gateway() {
  command -v netstat >/dev/null 2>&1 || return 0
  netstat -rn -f inet 2>/dev/null | awk '$1 == "default" { print $2; exit }'
}

# Does that hop answer? Separated from the question above it so the report can
# tell "no route" from "a route to something that is not there".
gateway_answers() {
  local gateway="$1"
  command -v ping >/dev/null 2>&1 || return 0
  ping -c 1 -t "${UPLINK_WAIT}" "${gateway}" >/dev/null 2>&1
}

# `reachable`, `portal`, `unresolved`, `offline`, or `unknown` where nothing
# could be asked.
#
# `unresolved` is its own answer rather than a kind of offline. Reaching the
# probe means resolving its name first, so a machine whose resolvers are gone
# fails here with the uplink perfectly fine, and this script detects two ways
# for that to happen: a dead VPN that left its resolvers behind, and resolvers
# whose route went with an aggregate. Reporting either of those as "nothing
# behind the gateway, nothing on this machine is broken" is the misdirection
# this whole section was written to stop.
uplink_state() {
  command -v curl >/dev/null 2>&1 || {
    echo unknown
    return 0
  }
  if command -v dig >/dev/null 2>&1; then
    # Two conditions, because the output alone is not enough. Measured: `dig
    # +short` against a resolver that has stopped answering exits 9 and prints
    # `;; connection timed out; no servers could be reached` on **stdout**, so a
    # check on the output reads that as a resolved name and hands the question
    # to `curl`, which spends its whole timeout in the same lookup and reports a
    # dead uplink. Dropping the lines that begin with `;` is what catches that
    # one. The status is the rule underneath it: a lookup that failed has not
    # answered, whatever it printed.
    local resolved status=0
    resolved="$(dig +time="${UPLINK_WAIT}" +tries=1 +short "${UPLINK_HOST}" 2>/dev/null)" || status=$?
    resolved="$(printf '%s\n' "${resolved}" | grep -v '^;' || true)"
    resolved="$(printf '%s' "${resolved}" | tr -d '[:space:]')"
    if [ "${status}" -ne 0 ] || [ -z "${resolved}" ]; then
      echo unresolved
      return 0
    fi
  fi
  local body status=0
  body="$(curl -4 -s --max-time "${UPLINK_WAIT}" "${UPLINK_PROBE}" 2>/dev/null)" || status=$?
  case "${status}" in
    0) ;;
    # 6 is curl's "could not resolve host" and nothing else is.
    6)
      echo unresolved
      return 0
      ;;
    *)
      echo offline
      return 0
      ;;
  esac
  case "${body}" in
    *"${UPLINK_SUCCESS}"*) echo reachable ;;
    *) echo portal ;;
  esac
}

# Network extensions that are activated but not enabled.
#
# This is the state a GlobalProtect that only a reboot could fix was in:
# `[activated waiting for user]`, which is the extension running now and not
# approved, so once its IPC drops nothing in userland can start it again.
extensions_waiting() {
  command -v systemextensionsctl >/dev/null 2>&1 || return 0
  systemextensionsctl list 2>/dev/null | awk -F'\t' '
    NF >= 6 && $2 == "*" && $1 != "*" {
      state = $6
      gsub(/^\[|\]$/, "", state)
      printf "%s|%s\n", $5, state
    }
  '
}

cmd_doctor() {
  local failures=0

  echo "Hammerspoon"
  if [ -d "${HAMMERSPOON_APP}" ]; then
    ok "installed"
  else
    bad "not installed — brew install --cask hammerspoon"
    failures=$((failures + 1))
  fi
  if pgrep -f 'Hammerspoon.app/Contents/MacOS' >/dev/null 2>&1; then
    ok "running"
  else
    bad "not running — open -a Hammerspoon"
    failures=$((failures + 1))
  fi

  echo "The Spoon"
  if spoon_link_is_live; then
    ok "linked into ${SPOONS}"
  elif spoon_is_stale_copy; then
    # Frozen at whatever it was when it was copied. Everything works and
    # nothing updates, which is worse than a clean break.
    bad "a copy, not a link — run: vpnbar link"
    note "${SPOONS}/VpnBar.spoon is a real directory, so brew upgrade"
    note "updates a copy of vpnbar that nothing is loading."
    failures=$((failures + 1))
  elif [ -L "${SPOONS}/VpnBar.spoon" ]; then
    bad "the link points at nothing — run: vpnbar link"
    note "$(printf '%s -> %s' "${SPOONS}/VpnBar.spoon" "$(readlink "${SPOONS}/VpnBar.spoon")")"
    failures=$((failures + 1))
  else
    bad "not linked — run: vpnbar link"
    failures=$((failures + 1))
  fi
  if [ -f "${INIT}" ] && grep -qF "${LOAD_MARK}" "${INIT}"; then
    ok "loaded from init.lua"
  else
    bad "init.lua does not load it — add: ${LOAD_LINE}"
    failures=$((failures + 1))
  fi

  echo "The menu bar"
  local frame="" hs_bin="" bartender=""
  bartender="$(bartender_state)"
  if hs_bin="$(find_hs)"; then
    frame="$(run_with_timeout 6 "${hs_bin}" -A -c 'local m = _G.vpnbar and _G.vpnbar.menubar; if not m then return "none" end local f = m:frame(); return string.format("%d %d %d", f.x, f.w, f.h)' 2>/dev/null | tail -1 || true)"
  fi
  case "${frame}" in
    "")
      # A doctor that could not examine the patient must not say "healthy".
      # This said "Nothing to fix" through a two-minute stretch in which
      # Hammerspoon answered nothing at all.
      bad "Hammerspoon did not answer within 6 seconds, so the icon could not be checked"
      note "Try again in a moment; this has been seen to pass on its own."
      note "If it keeps happening, enable the command line in the Hammerspoon"
      note "console: hs.ipc.cliInstall()"
      failures=$((failures + 1))
      ;;
    none)
      bad "not running inside Hammerspoon — run: vpnbar start"
      failures=$((failures + 1))
      ;;
    *)
      local x="${frame%% *}" h="${frame##* }"
      if [ "${h}" = "0" ]; then
        # A zero-height frame at x=0 is what an item Bartender 7 keeps in its
        # hidden section reports: no window on screen at all, rather than a
        # window parked off it. What this said before was "on screen at x=0".
        # It is one thing to fix, not two, so when Bartender owns up to it the
        # failure is counted there.
        if [ "${bartender}" = "hidden" ]; then
          note "the icon has no frame right now; Bartender's answer below says why"
        else
          bad "the icon has no frame right now, so it cannot be seen"
          failures=$((failures + 1))
        fi
      elif [ "${x}" -ge 0 ] 2>/dev/null; then
        ok "icon is on screen at x=${x}"
      else
        # This is the one nobody guesses. Bartender, Ice, Vanilla and the rest
        # hide an item by parking it at a large negative x. The item is running
        # and drawing; it is simply not where anyone can see it.
        bad "icon is parked off-screen at x=${x}"
        note "A menu bar manager is holding it there. Bartender knows it as"
        note "${BARTENDER_ITEM} — a name rather than an ordinal, because the"
        note "Spoon gives its status item an autosave name, so a decision"
        note "about it sticks. Add it to the manager's shown items. Ice and"
        note "Vanilla have the same idea under a different name."
        failures=$((failures + 1))
      fi
      ;;
  esac
  case "${bartender}" in
    visible) ok "Bartender shows it" ;;
    hidden)
      bad "Bartender is hiding it"
      note "Bartender's scripting does not move it out: \`show\` returns and"
      note "leaves the state at hidden. In Bartender's settings, under Menu Bar"
      note "Layout, drag the Hammerspoon item into the shown section. Its id:"
      note "${BARTENDER_ITEM}"
      failures=$((failures + 1))
      ;;
    unlisted)
      note "Bartender has not listed the icon; it does once the item is"
      note "created — vpnbar restart"
      ;;
  esac

  echo "The network"
  local gateway uplink
  gateway="$(default_gateway)"
  if [ -z "${gateway}" ]; then
    bad "nothing is routed off this machine"
    note "There is no default route. Every address goes nowhere, and no VPN"
    note "and nothing in this menu can fix that: there is no network to start"
    note "from."
    failures=$((failures + 1))
  else
    # The probe runs whatever the gateway does about ICMP. Plenty of them drop
    # it, and a working connection reported as a broken first hop is a wrong
    # answer in the direction this section exists to avoid. The ping is asked
    # afterwards, and only where it adds something: it tells a hotspot with no
    # data of its own from a Wi-Fi that joined and was handed nothing.
    uplink="$(uplink_state)"
    case "${uplink}" in
      reachable) ok "the internet answers through ${gateway}" ;;
      portal)
        bad "something answers for the internet, and it is not the internet"
        note "A captive portal is holding this connection. Open a browser and"
        note "give it whatever it is asking for."
        failures=$((failures + 1))
        ;;
      unresolved)
        bad "no name could be looked up, so the probe was never reached"
        note "Nothing resolves, which makes this a resolver and not an uplink."
        note "The two lines under The tunnel say whether a VPN left its own"
        note "resolvers behind, or whether a route they needed has gone."
        failures=$((failures + 1))
        ;;
      offline)
        if gateway_answers "${gateway}"; then
          bad "${gateway} answers and nothing behind it does"
          note "The first hop is fine and there is no internet beyond it: a"
          note "hotspot whose own mobile data is off, or a router with no"
          note "uplink. Nothing on this machine is broken."
        else
          bad "nothing answers, the default gateway ${gateway} included"
          note "A Wi-Fi that joined and was handed nothing looks like this, and"
          note "so does a cable that is in the wrong socket."
        fi
        failures=$((failures + 1))
        ;;
      *) note "curl is missing, so whether the internet answers was never asked" ;;
    esac
  fi

  echo "The tunnel"
  local stale
  stale="$(stale_routes)"
  if [ -z "${stale}" ]; then
    ok "no routes left behind by a tunnel that is down"
  else
    local count
    count="$(printf '%s\n' "${stale}" | wc -l | tr -d ' ')"
    bad "${count} route(s) point at a tunnel that is down — run: vpnbar clean"
    note "Every address they cover goes to an interface that carries nothing,"
    note "so the machine looks connected and reaches none of it."
    failures=$((failures + 1))
  fi
  local claimed claimedCount
  claimed="$(claimed_routes)"
  if [ -z "${claimed}" ]; then
    ok "no live tunnel has claimed the private address space"
  else
    claimedCount="$(printf '%s\n' "${claimed}" | wc -l | tr -d ' ')"
    bad "${claimedCount} route(s) send the private address space into a live tunnel — run: vpnbar clean"
    note "Everything they cover goes to the tunnel rather than the network"
    note "this machine is on, and nothing in the table looks broken."
    local behind behindCount
    behind="$(resolvers_behind "${claimed}")"
    if [ -n "${behind}" ]; then
      behindCount="$(printf '%s\n' "${behind}" | wc -l | tr -d ' ')"
      note "${behindCount} resolver(s) are reaching the tunnel through them, so"
      note "clean pins each to a host route before it deletes anything."
    fi
    failures=$((failures + 1))
  fi
  local staleDns
  staleDns="$(stale_dns)"
  if [ -z "${staleDns}" ]; then
    ok "no resolvers left over from a VPN that is gone"
  else
    local service servers
    while IFS='|' read -r service servers; do
      [ -n "${service}" ] || continue
      bad "${service} still points DNS at ${servers}, which answers nothing — run: vpnbar clean"
      failures=$((failures + 1))
    done <<EOF
${staleDns}
EOF
    note "Every name those resolvers were meant to answer fails, and every"
    note "lookup that reaches them waits for a timeout."
  fi
  local waiting
  waiting="$(extensions_waiting)"
  if [ -n "${waiting}" ]; then
    local name state
    while IFS='|' read -r name state; do
      [ -n "${name}" ] || continue
      bad "${name} is running but not approved (${state})"
      failures=$((failures + 1))
    done <<EOF
${waiting}
EOF
    note "System Settings > General > Login Items & Extensions > Network"
    note "Extensions. Unapproved is the state a VPN cannot recover from: once"
    note "its extension stops answering, nothing short of a reboot starts it"
    note "again, and its routes stay pointed at a dead tunnel until then."
  fi

  echo "Connections"
  local config="${HOME}/.config/vpnbar/profiles.json"
  if [ -f "${config}" ]; then
    ok "config at ${config}"
  else
    note "no config yet — the menu writes one when you add a connection"
  fi

  echo
  if [ "${failures}" -eq 0 ]; then
    echo "Nothing to fix."
  else
    echo "${failures} thing(s) to fix."
    exit 1
  fi
}

case "${1:-}" in
  link) cmd_link ;;
  unlink) cmd_unlink ;;
  app) cmd_app ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  doctor) cmd_doctor ;;
  clean)
    shift
    cmd_clean "$@"
    ;;
  *)
    echo "usage: ${0##*/} start|stop|restart|link|unlink|app|doctor|clean" >&2
    exit 2
    ;;
esac
